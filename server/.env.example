# --- Phase 1 (required to boot) ---
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173
# Run the in-process scheduler in this instance (set false on extra replicas)
SCHEDULER_ENABLED=true

DATABASE_URL=postgresql://user:password@localhost:5432/metricool
JWT_SECRET=change-me-to-a-long-random-string
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Later phases (leave blank for now) ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/api/oauth/instagram/callback

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:4000/api/oauth/tiktok/callback

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=metricool-media
R2_PUBLIC_URL=
